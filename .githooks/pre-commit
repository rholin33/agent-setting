#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

"$ROOT/scripts/sync-local-config.sh"
git -C "$ROOT" add -- \
  codex/AGENTS.md codex/hooks.json codex/hooks codex/rules codex/skills \
  pi/AGENTS.md pi/settings.json pi/skills pi/projects \
  ccb/ccb.config ccb/apply-pi-extension-reuse-patch.py

if [[ -d "$ROOT/ccb/projects" ]]; then
  git -C "$ROOT" add -- ccb/projects
fi

if ! git -C "$ROOT" diff --cached --check; then
  printf '%s\n' 'Pre-commit check failed: staged configuration contains whitespace errors.' >&2
  exit 1
fi

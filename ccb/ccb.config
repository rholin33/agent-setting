version = 2
entry_window = "master"

[windows]
master = "master:pi; loader:codex@50"
archi = "archi:pi"
coder = "coder1:codex; coder2:codex@50"
designer = "designer:pi"
reviewer = "reviewer:codex; test:codex@50"
simple = "simple:codex"

[ui.sidebar]
agents_height = "50%"
comms_height = "15%"
tips_height = "35%"

[agents.master]
model = "pay/gpt-6-astra"
role = "agentroles.ccb_self"

[agents.loader]
model = "gpt-5.6-terra"
thinking = "medium"
role = "agentroles.ccb_self"

[agents.archi]
model = "pay/gpt-6-astra"
role = "agentroles.archi"

[agents.coder1]
model = "gpt-5.6-sol"
thinking = "medium"
role = "agentroles.coder"

[agents.coder2]
model = "gpt-5.6-sol"
thinking = "medium"
role = "agentroles.coder"

[agents.designer]
role = "agentroles.frontend_engineer"
model = "local/gemini-3.8-flash-high"

[agents.reviewer]
model = "gpt-5.6-sol"
thinking = "xhigh"
role = "agentroles.code_reviewer"

[agents.test]
model = "gpt-5.6-terra"
thinking = "high"
role = "agentroles.code_reviewer"

[agents.simple]
model = "gpt-5.6-sol"
thinking = "xhigh"
role = "agentroles.simple"

# Portable project CCB topology.
# Provider credentials, API overrides, and runtime state are intentionally
# excluded. The local SessionStart/bootstrap integration supplies auth.
version = 2
entry_window = "master"

[windows]
master = "master:pi; loader:codex"
archi = "archi:pi"
coder = "coder1:codex; coder2:codex"
designer = "designer:codex"
reviewer = "reviewer:codex; test:codex"
simple = "simple:codex"

[ui.sidebar]
agents_height = "50%"
comms_height = "15%"
tips_height = "35%"

[agents.master]
role = "agentroles.ccb_self"

[agents.loader]
thinking = "high"
role = "agentroles.ccb_self"

[agents.archi]
role = "agentroles.archi"

[agents.coder1]
thinking = "medium"
role = "agentroles.coder"

[agents.coder2]
thinking = "medium"
role = "agentroles.coder"

# The designer lane owns all frontend implementation and focused UI tests.
[agents.designer]
thinking = "xhigh"
role = "agentroles.frontend_engineer"

[agents.reviewer]
thinking = "xhigh"
role = "agentroles.code_reviewer"

[agents.test]
thinking = "high"
role = "agentroles.code_reviewer"

[agents.simple]
thinking = "xhigh"
role = "agentroles.simple"

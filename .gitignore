.DS_Store
__pycache__/
*.pyc
.coverage
hooks/*.ps1

# Codex runtime and local state should never be synced.
auth.json
history.jsonl
*.sqlite
*.sqlite-*
log/
logs/
sessions/
shell_snapshots/
tmp/
.tmp/

# CCB agent directories are generated runtime state, not portable config.
ccb/agents/
ccb/*.bak.*

# Project Pi provider state is portable only through its settings.json.
pi/projects/**/agents/**/provider-state/pi/home/auth.json
pi/projects/**/agents/**/provider-state/pi/home/models.json
pi/projects/**/agents/**/provider-state/pi/home/models-store.json
pi/projects/**/agents/**/provider-state/pi/home/sessions/
pi/projects/**/agents/**/provider-state/pi/home/.npm/

# Local editor and OS metadata.
.idea/
.vscode/
